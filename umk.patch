+    var g = D.getElementById("umkIgo");
+    if (g && ev) g.onclick = function () { var e = ev; ev = null; close(); e.prompt(); e.userChoice.then(function (r) { gc("install-" + r.outcome, "Install prompt: " + r.outcome); }).catch(function () {}); };
